  "schemaVersion": "uvp.dock.compat.v1",
  "targetDefinition": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "payment_execution",
      "uid": "zx-payment-execution"
    },
    "spec": {
      "dockInterface": {
        "inputs": {
          "cancel": {
            "access": {
              "policy": "linked"
            },
            "hook": "payment_flow.control#DOCK_CANCEL",
            "kind": "signal"
          },
          "execute": {
            "access": {
              "policy": "permit"
            },
            "hook": "payment_flow.init#DOCK_EXECUTE",
            "kind": "entrance"
          }
        },
        "outputs": {
          "completed": {
            "signal": "payment::payment_flow.settle.cmp",
            "terminal": "success"
          },
          "failed": {
            "signal": "payment::payment_flow.settle.err",
            "terminal": "failure"
          },
          "started": {
            "signal": "payment::payment_flow.init.str"
          }
        },
        "schemaVersion": "uvp.dock.v1"
      },
      "nucleation": {
        "id": "payment-core"
      },
      "platform": {
        "type": "cloud"
      },
      "taskPatterns": [
        {
          "name": "payment_flow",
          "stages": [
            {
              "executor": {
                "supplierID": "payment-gateway",
                "supplierType": "organization"
              },
              "name": "init",
              "receiveSignals": {
                "DOCK_EXECUTE": "payment::payment_flow.init.execute"
              },
              "sendSignals": [
                "str"
              ],
              "source": "payment"
            },
            {
              "executor": {
                "supplierID": "payment-gateway",
                "supplierType": "organization"
              },
              "name": "control",
              "receiveSignals": {
                "DOCK_CANCEL": "payment::payment_flow.control.cancel"
              },
              "sendSignals": [
                "cxl"
              ],
              "source": "payment"
            },
            {
              "executor": {
                "supplierID": "payment-gateway",
                "supplierType": "organization"
              },
              "name": "settle",
              "receiveSignals": {
                "SETTLE": "payment::payment_flow.init.str"
              },
              "sendSignals": [
                "cmp",
                "err"
              ],
              "source": "payment"
            }
          ]
        }
      ]
    }
  }
