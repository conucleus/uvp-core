{
  "schemaVersion": "uvp.hookSemanticsCorpus.v1",
  "semanticVersion": "uvp.semantic.v1",
  "specRef": "docs/specs/subscription-mint-spec.md",
  "wikiRefs": [
    "uvp-wiki/wiki/concepts/core/hook.md",
    "uvp-wiki/wiki/concepts/core/signal.md",
    "uvp-wiki/wiki/concepts/core/source.md",
    "uvp-wiki/wiki/concepts/core/trigger.md",
    "uvp-wiki/wiki/concepts/state-machine/evaluation.md",
    "uvp-wiki/wiki/concepts/state-machine/timers-and-status.md",
    "uvp-wiki/wiki/concepts/state-machine/replay.md"
  ],
  "runtimeDeliveryModel": {
    "evm": "Core semantics produce chain events and replayable projections. Users or services may fetch results from chain/indexer.",
    "cloud": "Core semantics produce the same state, but cloud runtime can treat the engine as a black box and push computed user messages directly."
  },
  "parseCases": [
    {
      "name": "single positive signal",
      "profile": "evm_strict",
      "hookName": "START",
      "hook": "buyer::task.main.cmp",
      "expect": {
        "source": "buyer",
        "mode": "normal",
        "runtimeCondition": "task.main.cmp",
        "normalizedExpression": "buyer::task.main.cmp",
        "dependencies": [
          {
            "kind": "positive",
            "source": "buyer",
            "signalName": "task.main.cmp"
          }
        ]
      }
    },
    {
      "name": "delay with monotonic negative guard",
      "profile": "evm_strict",
      "hookName": "TIMEOUT",
      "hook": "buyer::(task.pay.cmp +5s) & ~task.refund.cmp",
      "expect": {
        "source": "buyer",
        "mode": "normal",
        "runtimeCondition": "task.pay.cmp+5s&~task.refund.cmp",
        "normalizedExpression": "buyer::task.pay.cmp+5s&~task.refund.cmp",
        "dependencies": [
          {
            "kind": "negative",
            "source": "buyer",
            "signalName": "task.refund.cmp"
          },
          {
            "kind": "positive",
            "source": "buyer",
            "signalName": "task.pay.cmp"
          },
          {
            "kind": "timer",
            "source": "buyer",
            "signalName": "task.pay.cmp",
            "delaySeconds": 5
          }
        ]
      }
    },
    {
      "name": "subscription entry fans class events into executor",
      "profile": "cloud_compat",
      "hookName": "SUBSCRIBE",
      "hook": "::ANCHOR(@seller::trade.listing.cmp)",
      "expect": {
        "source": "",
        "mode": "subscription",
        "runtimeCondition": "ANCHOR(@seller::trade.listing.cmp)",
        "normalizedExpression": "::ANCHOR(@seller::trade.listing.cmp)",
        "dependencies": [
          {
            "kind": "positive",
            "source": "seller",
            "signalName": "trade.listing.cmp"
          }
        ]
      }
    },
    {
      "name": "subscription entry addresses another class in the same domain",
      "profile": "cloud_compat",
      "hookName": "SUBSCRIBE",
      "hook": "::ANCHOR(@buyer::juice_demand.entry.requested)",
      "expect": {
        "source": "",
        "mode": "subscription",
        "runtimeCondition": "ANCHOR(@buyer::juice_demand.entry.requested)",
        "normalizedExpression": "::ANCHOR(@buyer::juice_demand.entry.requested)",
        "dependencies": [
          {
            "kind": "positive",
            "source": "buyer",
            "signalName": "juice_demand.entry.requested"
          }
        ]
      }
    },
    {
      "name": "subscription entry tolerates whitespace between ANCHOR and target",
      "profile": "cloud_compat",
      "hookName": "SUBSCRIBE",
      "hook": "::ANCHOR (@seller::t.a.b)",
      "expect": {
        "source": "",
        "mode": "subscription",
        "runtimeCondition": "ANCHOR(@seller::t.a.b)",
        "normalizedExpression": "::ANCHOR(@seller::t.a.b)",
        "dependencies": [
          {
            "kind": "positive",
            "source": "seller",
            "signalName": "t.a.b"
          }
        ]
      }
    }
  ],
