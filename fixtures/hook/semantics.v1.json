    {
      "name": "negative guard cancels monotonically",
      "profile": "evm_strict",
      "hookName": "PAY",
      "hook": "buyer::task.pay.cmp & ~task.refund.cmp",
      "now": "2026-04-27T00:00:06.000Z",
      "signals": [
        {
          "source": "buyer",
          "signalName": "task.pay.cmp",
          "receivedAt": "2026-04-27T00:00:00.000Z"
        },
        {
          "source": "buyer",
          "signalName": "task.refund.cmp",
          "receivedAt": "2026-04-27T00:00:03.000Z"
        }
      ],
      "expect": {
        "state": "impossible",
        "reasonContains": "negated condition exists: task.refund.cmp"
      }
    },
    {
      "name": "and waits on latest delayed branch",
      "profile": "evm_strict",
      "hookName": "BOTH",
      "hook": "buyer::(task.a.cmp +5s) & (task.b.cmp +10s)",
      "now": "2026-04-27T00:00:00.000Z",
      "signals": [
        {
          "source": "buyer",
          "signalName": "task.a.cmp",
          "receivedAt": "2026-04-27T00:00:00.000Z"
        },
        {
          "source": "buyer",
          "signalName": "task.b.cmp",
          "receivedAt": "2026-04-27T00:00:00.000Z"
        }
      ],
      "expect": {
        "state": "wait",
        "readyAt": "2026-04-27T00:00:10.000Z"
      }
    },
    {
      "name": "or waits on earliest live delayed branch",
