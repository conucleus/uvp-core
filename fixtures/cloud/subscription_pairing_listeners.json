{
  "name": "Subscription listeners fan cross-source class events into match executor",
  "semanticVersion": "uvp.semantic.v1",
  "target": "cloud",
  "portable": false,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "merge_entry"
    },
    "spec": {
      "platform": {
        "type": "cloud"
      },
      "nucleation": {
        "id": "core"
      },
      "stages": [
        {
          "name": "listing",
          "source": "seller",
          "sendSignals": [
            {
              "name": "cmp"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "seller-org"
          }
        },
        {
          "name": "intent",
          "source": "buyer",
          "sendSignals": [
            {
              "name": "cmp"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "buyer-org"
          }
        },
        {
          "name": "match",
          "source": "buyer",
          "receiveSignals": {
            "PAIR_SELLER": "::ANCHOR(@seller::listing.cmp)",
            "PAIR_BUYER": "::ANCHOR(@buyer::intent.cmp)"
          },
          "sendSignals": [
            {
              "name": "paired"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "match-org"
          }
        }
      ]
    }
  },
  "expect": {
    "cloudHookModes": {
      "PAIR_SELLER": "subscription",
      "PAIR_BUYER": "subscription"
    }
  }
}
