{
  "name": "receive hook with undeclared subscription source is rejected",
  "semanticVersion": "uvp.semantic.v1",
  "target": "cloud",
  "portable": false,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "undeclared_subscription_source"
    },
    "spec": {
      "platform": {
        "type": "cloud"
      },
      "nucleation": {
        "id": "core"
      },
      "stages": [
        {
          "name": "gate",
          "source": "farmer",
          "sendSignals": [
            {
              "name": "picked"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "farmer-org"
          }
        },
        {
          "name": "watch",
          "source": "buyer",
          "receiveSignals": {
            "PICK": "::ANCHOR(@ghost::gate.picked)"
          },
          "sendSignals": [
            {
              "name": "seen"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "market-org"
          }
        }
      ]
    }
  },
  "expect": {
    "errorContains": "is not a declared source in this zhixu"
  }
}
