{
  "name": "mutual mint subscriptions between two source classes are rejected as an unbounded re-mint cycle",
  "semanticVersion": "uvp.semantic.v1",
  "target": "cloud",
  "portable": false,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "mint_mutual_cycle"
    },
    "spec": {
      "platform": {
        "type": "cloud"
      },
      "nucleation": {
        "id": "core"
      },
      "taskPatterns": [
        {
          "name": "dispatch",
          "stages": [
            {
              "name": "main",
              "source": "producer",
              "receiveSignals": {
                "SPAWN": "::ANCHOR(@buyer::orchard.retail.ack)"
              },
              "sendSignals": [
                {
                  "name": "smart_contract"
                }
              ],
              "mint": "per-fact",
              "executor": {
                "supplierType": "organization",
                "supplierID": "dispatch-main-executor"
              }
            }
          ]
        },
        {
          "name": "orchard",
          "stages": [
            {
              "name": "retail",
              "source": "buyer",
              "receiveSignals": {
                "SPAWN": "::ANCHOR(@producer::dispatch.main.smart_contract)"
              },
              "sendSignals": [
                {
                  "name": "ack"
                }
              ],
              "mint": "per-fact",
              "executor": {
                "supplierType": "organization",
                "supplierID": "orchard-retail-executor"
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "errorContains": "mint subscriptions form an unbounded re-mint cycle"
  }
}
