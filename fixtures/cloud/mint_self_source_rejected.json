{
  "name": "mint stage subscribing its own source class is rejected",
  "semanticVersion": "uvp.semantic.v1",
  "target": "cloud",
  "portable": false,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "mint_self_source"
    },
    "spec": {
      "platform": {
        "type": "cloud"
      },
      "nucleation": {
        "id": "core"
      },
      "stages": [
        {
          "name": "gate",
          "source": "farmer",
          "sendSignals": [
            {
              "name": "picked"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "farmer-org"
          }
        },
        {
          "name": "mint",
          "source": "farmer",
          "receiveSignals": {
            "PICK": "::ANCHOR(@farmer::gate.picked)"
          },
          "sendSignals": [
            {
              "name": "born"
            }
          ],
          "mint": "per-fact"
        }
      ]
    }
  },
  "expect": {
    "errorContains": "must not subscribe its own source class"
  }
}
