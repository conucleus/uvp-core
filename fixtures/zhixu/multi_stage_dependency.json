{
  "name": "multi-stage dependency fans two upstreams into one hook",
  "semanticVersion": "uvp.semantic.v1",
  "target": "hook_plan",
  "portable": true,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "multi_stage_dep",
      "uid": "fx-fanin-001",
      "annotations": {
        "version": "1"
      }
    },
    "spec": {
      "platform": {
        "type": "cloud"
      },
      "nucleation": {
        "id": "core"
      },
      "taskPatterns": [
        {
          "name": "pipeline",
          "stages": [
            {
              "name": "one",
              "source": "buyer",
              "sendSignals": [
                "done"
              ],
              "executor": {
                "supplierType": "organization",
                "supplierID": "org-a"
              }
            },
            {
              "name": "two",
              "source": "buyer",
              "sendSignals": [
                "done"
              ],
              "executor": {
                "supplierType": "organization",
                "supplierID": "org-b"
              }
            },
            {
              "name": "three",
              "source": "buyer",
              "receiveSignals": {
                "FINISH": "buyer::(pipeline.one.done & pipeline.two.done)"
              },
              "sendSignals": [
                "cmp"
              ],
              "executor": {
                "supplierType": "organization",
                "supplierID": "org-c"
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "platform": "cloud",
    "hookIds": [
      "pipeline.three#FINISH"
    ],
    "hookDependencyCounts": {
      "pipeline.three#FINISH": 2
    }
  }
}