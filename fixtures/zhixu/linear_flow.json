{
  "name": "linear flow across two stages",
  "semanticVersion": "uvp.semantic.v1",
  "target": "hook_plan",
  "portable": true,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "linear_flow"
    },
    "spec": {
      "platform": {
        "type": "cloud"
      },
      "nucleation": {
        "id": "core"
      },
      "taskPatterns": [
        {
          "name": "flow",
          "stages": [
            {
              "name": "start",
              "source": "buyer",
              "receiveSignals": {
                "BEGIN": "buyer::flow.start.seed"
              },
              "sendSignals": [
                {
                  "name": "seed"
                },
                {
                  "name": "step_done"
                }
              ],
              "executor": {
                "supplierType": "organization",
                "supplierID": "org-a"
              }
            },
            {
              "name": "finish",
              "source": "buyer",
              "receiveSignals": {
                "FINISH": "buyer::flow.start.step_done"
              },
              "sendSignals": [
                {
                  "name": "cmp"
                }
              ],
              "executor": {
                "supplierType": "organization",
                "supplierID": "org-b"
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "platform": "cloud",
    "hookIds": [
      "flow.finish#FINISH",
      "flow.start#BEGIN"
    ],
    "hookDependencyCounts": {
      "flow.finish#FINISH": 1,
      "flow.start#BEGIN": 1
    }
  }
}
