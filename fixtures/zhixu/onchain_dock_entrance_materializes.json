{
  "name": "dock entrance hook materializes a stage without a static executor",
  "semanticVersion": "uvp.semantic.v1",
  "target": "hook_plan",
  "portable": true,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "dock_entrance_gate"
    },
    "spec": {
      "platform": {
        "type": "evm"
      },
      "nucleation": {
        "id": "core"
      },
      "dockInterface": {
        "guest_arrival": {
          "orderModes": [
            "new"
          ],
          "inputs": {
            "enter": {
              "hook": "guest.arrival#DOCK_ENTER"
            }
          }
        }
      },
      "taskPatterns": [
        {
          "name": "guest",
          "stages": [
            {
              "name": "host",
              "source": "buyer",
              "receiveSignals": {
                "BEGIN": "buyer::guest.host.seed"
              },
              "sendSignals": [
                {
                  "name": "go"
                },
                {
                  "name": "seed"
                }
              ],
              "selectedStages": [
                "guest.arrival"
              ],
              "executor": {
                "supplierType": "organization",
                "supplierID": "org-host"
              }
            },
            {
              "name": "arrival",
              "source": "buyer",
              "receiveSignals": {
                "DOCK_ENTER": "buyer::guest.arrival.enter"
              },
              "sendSignals": [
                {
                  "name": "cmp"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "platform": "evm",
    "hookIds": [
      "guest.arrival#DOCK_ENTER",
      "guest.host#BEGIN"
    ]
  }
}
