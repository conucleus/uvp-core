{
  "name": "dock entrance hook materializes a stage without a static executor",
  "semanticVersion": "uvp.semantic.v1",
  "target": "hook_plan",
  "portable": true,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "dock_entrance_gate"
    },
    "spec": {
      "platform": {
        "type": "evm"
      },
      "nucleation": {
        "id": "core"
      },
      "dockInterface": {
        "guest_arrival": {
          "orderModes": [
            "new"
          ],
          "inputs": {
            "enter": {
              "hook": "arrival#DOCK_ENTER"
            }
          }
        }
      },
      "stages": [
        {
          "name": "host",
          "source": "buyer",
          "receiveSignals": {
            "BEGIN": "buyer::host.seed"
          },
          "sendSignals": [
            {
              "name": "go"
            },
            {
              "name": "seed"
            }
          ],
          "selectedStages": [
            "arrival"
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "org-host"
          }
        },
        {
          "name": "arrival",
          "source": "buyer",
          "receiveSignals": {
            "DOCK_ENTER": "buyer::arrival.enter"
          },
          "sendSignals": [
            {
              "name": "cmp"
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "platform": "evm",
    "hookIds": [
      "arrival#DOCK_ENTER",
      "host#BEGIN"
    ]
  }
}
