{
  "name": "delegation binds resolved dock routes with independent child orders",
  "semanticVersion": "uvp.semantic.v1",
  "target": "hook_plan",
  "portable": true,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "sourcing"
    },
    "spec": {
      "nucleation": {
        "id": "sourcing-core"
      },
      "platform": {
        "type": "cloud"
      },
      "stages": [
        {
          "executor": {
            "supplierID": "purchaser-app",
            "supplierType": "organization"
          },
          "name": "confirm",
          "receiveSignals": {
            "ORDER": "purchaser::confirm.seed"
          },
          "sendSignals": [
            {
              "name": "cmp"
            },
            {
              "name": "seed"
            }
          ],
          "source": "purchaser"
        },
        {
          "executor": {
            "supplierType": "zhixu",
            "zhixuExecutorConfig": {
              "inputMap": {
                "EXECUTE": "execute"
              },
              "interface": "production_service",
              "order": {
                "mode": "new"
              },
              "signalMap": {
                "cmp": "completed",
                "str": "started"
              },
              "target": {
                "zhixu": "zx-0123456789abcdef0123456789abcdef"
              }
            }
          },
          "name": "manufacture",
          "receiveSignals": {
            "EXECUTE": "purchaser::confirm.cmp"
          },
          "sendSignals": [
            {
              "name": "str"
            },
            {
              "name": "cmp"
            }
          ],
          "source": "purchaser"
        },
        {
          "executor": {
            "supplierType": "zhixu",
            "zhixuExecutorConfig": {
              "interface": "production_evidence",
              "order": {
                "mode": "existing"
              },
              "signalMap": {
                "cmp": "scrap_declared"
              },
              "target": {
                "zhixu": "zx-0123456789abcdef0123456789abcdef"
              }
            }
          },
          "name": "source_evidence",
          "receiveSignals": {
            "READ": "recycler::source_evidence.seed"
          },
          "sendSignals": [
            {
              "name": "cmp"
            },
            {
              "name": "seed"
            }
          ],
          "source": "recycler"
        }
      ]
    }
  },
  "expect": {
    "platform": "cloud",
    "hookDependencyCounts": {
      "confirm#ORDER": 1,
      "manufacture#EXECUTE": 1,
      "source_evidence#READ": 1
    },
    "hookIds": [
      "confirm#ORDER",
      "manufacture#EXECUTE",
      "source_evidence#READ"
    ],
    "dockRouteCount": 2
  },
  "dockTargets": [
    {
      "uid": "zx-0123456789abcdef0123456789abcdef",
      "definition": {
        "apiVersion": "uvp/v0",
        "kind": "Zhixu",
        "metadata": {
          "name": "friction_wheel_production"
        },
        "spec": {
          "platform": {
            "type": "cloud"
          },
          "nucleation": {
            "id": "friction-wheel-core"
          },
          "dockInterface": {
            "production_evidence": {
              "orderModes": [
                "existing"
              ],
              "inputs": {},
              "outputs": {
                "scrap_declared": {
                  "signal": "factory::produce.scrap_created"
                }
              }
            },
            "production_service": {
              "orderModes": [
                "new"
              ],
              "inputs": {
                "amend": {
                  "hook": "produce#DOCK_AMEND"
                },
                "execute": {
                  "hook": "intake#EXECUTE"
                }
              },
              "outputs": {
                "completed": {
                  "signal": "factory::produce.cmp"
                },
                "started": {
                  "signal": "factory::intake.str"
                }
              }
            }
          },
          "stages": [
            {
              "name": "intake",
              "source": "factory"
            },
            {
              "name": "produce",
              "source": "factory"
            }
          ]
        }
      }
    }
  ]
}
