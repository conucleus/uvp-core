{
  "name": "delegation binds resolved dock routes with independent child orders",
  "semanticVersion": "uvp.semantic.v1",
  "target": "hook_plan",
  "portable": true,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "sourcing"
    },
    "spec": {
      "nucleation": {
        "id": "sourcing-core"
      },
      "platform": {
        "type": "cloud"
      },
      "taskPatterns": [
        {
          "name": "procurement",
          "stages": [
            {
              "executor": {
                "supplierID": "purchaser-app",
                "supplierType": "organization"
              },
              "name": "confirm",
              "receiveSignals": {
                "ORDER": "purchaser::procurement.confirm.seed"
              },
              "sendSignals": [
                "cmp",
                "seed"
              ],
              "source": "purchaser"
            }
          ]
        },
        {
          "name": "sourcing",
          "stages": [
            {
              "executor": {
                "supplierType": "zhixu",
                "zhixuExecutorConfig": {
                  "inputMap": {
                    "EXECUTE": "execute"
                  },
                  "interface": "production_service",
                  "order": {
                    "mode": "new"
                  },
                  "signalMap": {
                    "cmp": "completed",
                    "str": "started"
                  },
                  "target": {
                    "zhixu": "friction_wheel_production"
                  }
                }
              },
              "name": "manufacture",
              "receiveSignals": {
                "EXECUTE": "purchaser::procurement.confirm.cmp"
              },
              "sendSignals": [
                "str",
                "cmp"
              ],
              "source": "purchaser"
            },
            {
              "executor": {
                "supplierType": "zhixu",
                "zhixuExecutorConfig": {
                  "interface": "production_evidence",
                  "order": {
                    "mode": "existing"
                  },
                  "signalMap": {
                    "cmp": "scrap_declared"
                  },
                  "target": {
                    "zhixu": "friction_wheel_production"
                  }
                }
              },
              "name": "source_evidence",
              "receiveSignals": {
                "READ": "recycler::sourcing.source_evidence.seed"
              },
              "sendSignals": [
                "cmp",
                "seed"
              ],
              "source": "recycler"
            }
          ]
        }
      ]
    }
  },
  "resolutionManifest": {
    "schemaVersion": "uvp.dock.resolution.v2",
    "definitions": [
      {
        "name": "friction_wheel_production",
        "dockEdges": [],
        "interfaces": [
          {
            "name": "production_evidence",
            "orderModes": [
              "existing"
            ],
            "inputs": {},
            "outputs": {
              "scrap_declared": {
                "signal": "factory::manufacturing.produce.scrap_created"
              }
            }
          },
          {
            "name": "production_service",
            "orderModes": [
              "new"
            ],
            "inputs": {
              "amend": {
                "source": "factory",
                "hook": "manufacturing.produce#DOCK_AMEND"
              },
              "execute": {
                "source": "factory",
                "hook": "manufacturing.intake#EXECUTE"
              }
            },
            "outputs": {
              "completed": {
                "signal": "factory::manufacturing.produce.cmp"
              },
              "started": {
                "signal": "factory::manufacturing.intake.str"
              }
            }
          }
        ]
      }
    ]
  },
  "expect": {
    "platform": "cloud",
    "hookDependencyCounts": {
      "procurement.confirm#ORDER": 1,
      "sourcing.manufacture#EXECUTE": 1,
      "sourcing.source_evidence#READ": 1
    },
    "hookIds": [
      "procurement.confirm#ORDER",
      "sourcing.manufacture#EXECUTE",
      "sourcing.source_evidence#READ"
    ],
    "dockRouteCount": 2
  }
}
