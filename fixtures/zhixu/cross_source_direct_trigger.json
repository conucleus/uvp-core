{
  "name": "cross-source direct trigger consumes another source's signal",
  "semanticVersion": "uvp.semantic.v1",
  "target": "hook_plan",
  "portable": true,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "cross_source_trigger"
    },
    "spec": {
      "platform": {
        "type": "cloud"
      },
      "nucleation": {
        "id": "core"
      },
      "taskPatterns": [
        {
          "name": "supply",
          "stages": [
            {
              "name": "listing",
              "source": "seller",
              "receiveSignals": {
                "PUBLISH": "seller::supply.listing.seed"
              },
              "sendSignals": [
                {
                  "name": "listing_ready"
                },
                {
                  "name": "seed"
                }
              ],
              "executor": {
                "supplierType": "organization",
                "supplierID": "seller-org"
              }
            }
          ]
        },
        {
          "name": "demand",
          "stages": [
            {
              "name": "watch",
              "source": "buyer",
              "receiveSignals": {
                "WATCH": "seller::supply.listing.listing_ready"
              },
              "sendSignals": [
                {
                  "name": "ack"
                }
              ],
              "executor": {
                "supplierType": "organization",
                "supplierID": "buyer-org"
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "platform": "cloud",
    "hookIds": [
      "demand.watch#WATCH",
      "supply.listing#PUBLISH"
    ],
    "hookDependencyCounts": {
      "demand.watch#WATCH": 1,
      "supply.listing#PUBLISH": 1
    }
  }
}
