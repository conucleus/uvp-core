{
  "name": "order-trigger on an executor-less stage is rejected",
  "semanticVersion": "uvp.semantic.v1",
  "target": "hook_plan",
  "portable": false,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "dynamic_trigger_stage"
    },
    "spec": {
      "platform": {
        "type": "evm"
      },
      "nucleation": {
        "id": "core"
      },
      "stages": [
        {
          "name": "anchor",
          "source": "buyer",
          "selectedStages": [
            "entry"
          ],
          "receiveSignals": {
            "BEGIN": "buyer::anchor.self_ready"
          },
          "sendSignals": [
            {
              "name": "self_ready"
            },
            {
              "name": "go"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "org-a"
          }
        },
        {
          "name": "entry",
          "source": "buyer",
          "sendSignals": [
            {
              "name": "born",
              "trigger": true
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "errorContains": "trigger requires its own static individual/organization executor with supplierID"
  }
}
