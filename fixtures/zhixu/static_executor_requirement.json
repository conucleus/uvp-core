{
  "name": "merge pairing entry requires the static executor it delivers to",
  "semanticVersion": "uvp.semantic.v1",
  "target": "hook_plan",
  "portable": true,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "static_executor_ok"
    },
    "spec": {
      "platform": {
        "type": "cloud"
      },
      "nucleation": {
        "id": "core"
      },
      "stages": [
        {
          "name": "listing",
          "source": "seller",
          "receiveSignals": {
            "PUBLISH": "seller::listing.seed"
          },
          "sendSignals": [
            {
              "name": "cmp"
            },
            {
              "name": "seed"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "seller-org"
          }
        },
        {
          "name": "intent",
          "source": "buyer",
          "receiveSignals": {
            "PUBLISH": "buyer::intent.seed"
          },
          "sendSignals": [
            {
              "name": "cmp"
            },
            {
              "name": "seed"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "buyer-org"
          }
        },
        {
          "name": "pool",
          "source": "buyer",
          "receiveSignals": {
            "MATCH_SELLER": "::ANCHOR(@seller::listing.cmp)",
            "MATCH_BUYER": "::ANCHOR(@buyer::intent.cmp)"
          },
          "sendSignals": [
            {
              "name": "matched"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "market-org"
          }
        }
      ]
    }
  },
  "expect": {
    "platform": "cloud",
    "hookIds": [
      "intent#PUBLISH",
      "listing#PUBLISH",
      "pool#MATCH_BUYER",
      "pool#MATCH_SELLER"
    ],
    "hookDependencyCounts": {
      "intent#PUBLISH": 1,
      "listing#PUBLISH": 1,
      "pool#MATCH_BUYER": 1,
      "pool#MATCH_SELLER": 1
    }
  }
}
