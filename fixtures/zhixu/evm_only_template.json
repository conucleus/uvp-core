{
  "name": "evm-only template pins chain platform and portable hooks",
  "semanticVersion": "uvp.semantic.v1",
  "target": "hook_plan",
  "portable": true,
  "input": {
    "apiVersion": "uvp/v0",
    "kind": "Zhixu",
    "metadata": {
      "name": "evm_only_template"
    },
    "spec": {
      "platform": {
        "type": "evm",
        "provider": "anvil",
        "network": "local"
      },
      "nucleation": {
        "id": "core"
      },
      "stages": [
        {
          "name": "hold",
          "source": "buyer",
          "receiveSignals": {
            "LOCK": "buyer::hold.locked"
          },
          "sendSignals": [
            {
              "name": "locked"
            }
          ],
          "executor": {
            "supplierType": "organization",
            "supplierID": "chain-org"
          }
        }
      ]
    }
  },
  "expect": {
    "platform": "evm",
    "hookIds": [
      "hold#LOCK"
    ]
  }
}
